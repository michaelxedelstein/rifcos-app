{
  "rules": {
    "providerLocations": {
      "$providerId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $providerId"
      }
    },
    "providerPresence": {
      "$providerId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $providerId"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
